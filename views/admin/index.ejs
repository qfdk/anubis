<%- include('../includes/header'); %>
<div class="jumbotron">
    <h2>监狱列表</h2>
    <p>展示的规则列表，未激活的规则请仔细检查，删除一个配置文件可能会删除多个规则</p>
    <a class="btn btn-primary" href="<%- process.env.BASE_PATH; %>/admin/jails/add"><i class="fa fa-plus-square"
                                                                                      aria-hidden="true"></i> 添加新规则</a>
</div>
<div class="panel panel-default">
    <div class="panel-heading">
        激活规则【<%- activeJails; %>】/ 规则列表【<%= results.length; %>】
    </div>
    <table class="table">
        <thead>
        <tr>
            <th>#</th>
            <th>监狱名称</th>
            <th>配置文件</th>
            <th>激活</th>
            <th>操作</th>
        </tr>
        </thead>
        <tbody>
        <% for(let i = 0;i < results.length;i++){ %>
            <tr>
                <th scope="row">
                    <%- i + 1; %>
                </th>
                <td>
                    <%- results[i].jailname; %>
                </td>
                <td>
                    <small class="text-muted"><%- results[i].configFile; %></small>
                </td>
                <td>
                    <form action="<%- process.env.BASE_PATH; %>/admin/jails/toggle/<%- results[i].jailname; %>" method="POST" style="display:inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="targetEnabled" value="<%= !results[i].isActive %>">
                        <% if(results[i].isActive){ %>
                            <button type="submit" class="btn btn-xs btn-success">启用中</button>
                        <% }else{ %>
                            <button type="submit" class="btn btn-xs btn-default">已禁用</button>
                        <% } %>
                    </form>
                </td>
                <td>
                    <a class="btn btn-xs btn-info"
                       href="<%- process.env.BASE_PATH; %>/admin/jails/info/<%- results[i].jailname; %>"><i
                                class="fa fa-search" aria-hidden="true"></i> 探视</a>
                    <a class="btn btn-xs btn-primary"
                       href="<%- process.env.BASE_PATH; %>/admin/jails/edit/<%- results[i].jailname; %>?file=<%- results[i].configFile; %>"><i
                                class="fa fa-pencil" aria-hidden="true"></i> 编辑</a>
                    <form action="<%- process.env.BASE_PATH; %>/admin/jails/delete/<%- results[i].jailname; %>" method="POST" style="display:inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="configFile" value="<%- results[i].configFile; %>">
                        <button type="submit" class="btn btn-xs btn-danger"><i class="fa fa-trash" aria-hidden="true"></i> 删除</button>
                    </form>
                </td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>
<%- include('../includes/footer'); %>