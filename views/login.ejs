<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="utf-8">
    <title>ⲁⲛⲟⲩⲡ</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: #0e0c09;
            font-family: -apple-system, "system-ui", "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card {
            background: #161310;
            border: 1px solid #2e2820;
            border-radius: 10px;
            padding: 44px 40px;
            width: 100%;
            max-width: 360px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.6);
        }
        .logo {
            font-size: 28px;
            font-weight: 600;
            color: #c8a96e;
            letter-spacing: 0.06em;
            margin-bottom: 4px;
        }
        .subtitle {
            font-size: 12px;
            color: #5a5040;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 36px;
        }
        label {
            display: block;
            font-size: 12px;
            color: #7a6a52;
            margin-bottom: 6px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        input {
            width: 100%;
            background: #0e0c09;
            border: 1px solid #2e2820;
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 14px;
            color: #d4c4a0;
            outline: none;
            transition: border-color 0.2s;
            margin-bottom: 20px;
        }
        input:focus {
            border-color: #c8a96e;
            box-shadow: 0 0 0 3px rgba(200,169,110,0.08);
        }
        button {
            width: 100%;
            background: #c8a96e;
            border: none;
            border-radius: 6px;
            padding: 11px;
            font-size: 14px;
            font-weight: 600;
            color: #0e0c09;
            cursor: pointer;
            letter-spacing: 0.04em;
            transition: background 0.2s;
            margin-top: 4px;
        }
        button:hover { background: #d4b87a; }
        .divider {
            width: 32px;
            height: 1px;
            background: #c8a96e;
            opacity: 0.3;
            margin-bottom: 36px;
        }
    </style>
</head>
<body>
<div class="card">
    <div class="logo">ⲁⲛⲟⲩⲡ</div>
    <div class="subtitle">fail2ban 管理后台</div>
    <div class="divider"></div>
    <form action="<%- process.env.BASE_PATH; %>/auth/login" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="username">用户名</label>
        <input type="text" name="username" id="username" autocomplete="username" required>
        <label for="password">密码</label>
        <input type="password" name="password" id="password" autocomplete="current-password" required>
        <button type="submit">登 录</button>
    </form>
</div>
</body>
</html>
